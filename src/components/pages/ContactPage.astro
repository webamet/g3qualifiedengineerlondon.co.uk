---
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import ContentSections from '../../components/content/ContentSections.astro';
import FAQBlock from '../../components/content/FAQBlock.astro';
import RelatedReading from '../../components/content/RelatedReading.astro';
import ContactFormReact from '../../components/forms/ContactFormReact.tsx';

const { page } = Astro.props;
---
<div>
  <section class="bg-gradient-to-br from-navy-900 via-navy-800 to-blue-900 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">{page.h1}</h1>
      <p class="mt-4 text-base sm:text-lg text-blue-100 max-w-2xl">{page.answer}</p>
    </div>
  </section>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={page.breadcrumb} />
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <ContentSections sections={page.sections} />
        <FAQBlock faqs={page.faqs} />
        <RelatedReading links={page.links} />
      </div>
      <div class="lg:sticky lg:top-24 h-fit">
        <ContactFormReact client:load />
      </div>
    </div>
  </div>
</div>
