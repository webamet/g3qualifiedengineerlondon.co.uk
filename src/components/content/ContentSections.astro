---
const { sections } = Astro.props;
---
<div class="space-y-8 sm:space-y-10">
  {sections.map((section) => (
    <section>
      <h2 class="text-xl sm:text-2xl font-bold text-navy-900 mb-3 leading-snug">{section.heading}</h2>
      {section.paragraphs.map((para) => (
        <p class="text-slate-700 leading-relaxed mb-3 text-[16px] sm:text-[17px]">{para}</p>
      ))}
      {section.bullets && section.bullets.length > 0 && (
        <ul class="mt-4 space-y-2.5">
          {section.bullets.map((bullet) => (
            <li class="flex items-start gap-2.5 text-slate-700">
              <svg class="w-5 h-5 text-orange-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-[16px] leading-relaxed">{bullet}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</div>
