---
const { page } = Astro.props;
---
<section class="bg-gradient-to-br from-navy-900 via-navy-800 to-blue-900 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight leading-tight max-w-3xl">{page.h1}</h1>
    <p class="mt-4 text-base sm:text-lg text-blue-100 max-w-2xl leading-relaxed">{page.answer}</p>
    <slot />
  </div>
</section>
