---
const { children } = Astro.props;
---
<div class="mt-8 rounded-lg bg-orange-50 border-l-4 border-orange-500 p-5">
  <div class="flex items-start gap-3">
    <svg class="w-5 h-5 text-orange-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
    <div class="text-sm text-slate-700 leading-relaxed">
      {children || 'Do not attempt to bypass, block or hold open safety valves. If water is discharging, do not touch the discharged water. Contact a suitably competent engineer for on-site diagnosis.'}
    </div>
  </div>
</div>
