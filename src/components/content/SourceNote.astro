---
import site from '../../data/site.json';
const { sourceIds } = Astro.props;
const sources = (sourceIds || []).map((id) => site.sources[id]).filter(Boolean);
---
{sources.length > 0 && (
  <section class="mt-10 rounded-lg bg-blue-50 border border-blue-100 p-5 sm:p-6">
    <h2 class="flex items-center gap-2 text-sm font-bold text-navy-900 mb-3">
      <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
      Source references
    </h2>
    <ul class="space-y-2">
      {sources.map((source) => (
        <li>
          <a
            href={source.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-2 text-sm text-blue-700 hover:text-blue-900 transition-colors break-all"
          >
            <svg class="w-3.5 h-3.5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-0L10 14" /></svg>
            {source.name}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
