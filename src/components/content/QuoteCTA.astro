---
import site from '../../data/site.json';
const { } = Astro.props;
---
<section class="mt-12 rounded-2xl bg-gradient-to-br from-orange-600 to-orange-700 text-white p-6 sm:p-8 lg:p-10">
  <h2 class="text-xl sm:text-2xl font-bold mb-2">Discuss your cylinder enquiry</h2>
  <p class="text-orange-50 text-[15px] sm:text-base mb-6 max-w-xl">
    Call with your postcode, equipment make and model, and a description of the symptom. The enquiry establishes scope and availability; it is not an automatic booking.
  </p>
  <div class="flex flex-col sm:flex-row gap-3">
    <a
      href={`tel:${site.phoneE164}`}
      class="flex items-center justify-center gap-2 bg-white text-orange-700 font-semibold px-5 py-3 rounded-lg hover:bg-orange-50 transition-colors text-sm"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.27 1.02l-2.2 2.2a16 16 0 006.36 6.36l2.2-2.2a1 1 0 011.02-.27l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" /></svg>
      {site.phoneDisplay}
    </a>
    <a
      href={`mailto:${site.email}`}
      class="flex items-center justify-center gap-2 bg-navy-900 text-white font-semibold px-5 py-3 rounded-lg hover:bg-navy-800 transition-colors text-sm"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      Email us
    </a>
    <a
      href="/contact"
      class="flex items-center justify-center gap-2 border border-white/30 text-white font-semibold px-5 py-3 rounded-lg hover:bg-white/10 transition-colors text-sm"
    >
      Enquiry form
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
    </a>
  </div>
</section>
