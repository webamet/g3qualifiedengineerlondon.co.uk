---
const { links, title = 'Related reading' } = Astro.props;
---
{links?.length > 0 && (
  <section class="mt-12">
    <h2 class="text-xl sm:text-2xl font-bold text-navy-900 mb-5">{title}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {links.map((link) => (
        <a
          href={link.path}
          class="group flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3.5 hover:border-orange-300 hover:shadow-md transition-all"
        >
          <span class="text-[15px] font-medium text-navy-800 group-hover:text-orange-700 transition-colors">{link.label}</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-orange-600 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      ))}
    </div>
  </section>
)}
