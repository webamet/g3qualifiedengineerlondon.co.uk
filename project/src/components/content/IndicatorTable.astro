---
const { rows, caption } = Astro.props;
---
{rows?.length > 0 && (
  <section class="mt-8">
    <h2 class="text-xl sm:text-2xl font-bold text-navy-900 mb-4">Indicator reference</h2>
    {caption && <p class="text-sm text-slate-600 mb-3">{caption}</p>}
    <div class="overflow-x-auto rounded-lg border border-slate-200">
      <table class="w-full text-sm">
        <thead class="bg-navy-900 text-white">
          <tr>
            <th scope="col" class="px-4 py-3 text-left font-semibold">Pattern</th>
            <th scope="col" class="px-4 py-3 text-left font-semibold">Meaning</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {rows.map((row, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
              <td class="px-4 py-3 font-medium text-navy-800 whitespace-nowrap">{row.pattern}</td>
              <td class="px-4 py-3 text-slate-700">{row.meaning}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
