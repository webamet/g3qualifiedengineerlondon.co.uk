---
import site from '../../data/site.json';
import { pages } from '../../lib/content';
import PageHero from '../../components/content/PageHero.astro';
import ContentSections from '../../components/content/ContentSections.astro';
import FAQBlock from '../../components/content/FAQBlock.astro';
import SourceNote from '../../components/content/SourceNote.astro';
import ProductImage from '../../components/content/ProductImage.astro';

const { page } = Astro.props;

const servicesPage = pages.find((p) => p.path === '/services');
const problemsPage = pages.find((p) => p.path === '/problems');
const areasPage = pages.find((p) => p.path === '/areas');
const brandsPage = pages.find((p) => p.path === '/brands');
const knowledgePage = pages.find((p) => p.path === '/knowledge');

const heroImage = page.image;
---
<div id="home">
  <section class="bg-gradient-to-br from-navy-900 via-navy-800 to-blue-900 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight">{page.h1}</h1>
          <p class="mt-5 text-lg sm:text-xl text-blue-100 leading-relaxed max-w-xl">{page.answer}</p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={`tel:${site.phoneE164}`} class="flex items-center justify-center gap-2 bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-3.5 rounded-lg transition-colors text-[16px]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.27 1.02l-2.2 2.2a16 16 0 006.36 6.36l2.2-2.2a1 1 0 011.02-.27l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" /></svg>
              {site.phoneDisplay}
            </a>
            <a href={`mailto:${site.email}`} class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-6 py-3.5 rounded-lg transition-colors text-[16px] break-all">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <span class="truncate">{site.email}</span>
            </a>
          </div>
        </div>
        {heroImage && (
          <div class="flex justify-center lg:justify-end">
            <ProductImage src={heroImage} alt="Megaflo Eco direct unvented cylinder product reference" eager={true} caption="Product reference image — not a customer installation" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section id="services" class="py-12 sm:py-16 lg:py-20 bg-paleBlue-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900">Services</h2>
        <p class="mt-3 text-slate-600 max-w-2xl mx-auto">Diagnosis-led unvented cylinder and Megaflo work across London. Each enquiry establishes scope and availability.</p>
      </div>
      {servicesPage && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {servicesPage.links.slice(0, 9).map((link) => (
            <a href={link.path} class="group bg-white rounded-xl border border-slate-200 p-5 hover:border-orange-300 hover:shadow-lg transition-all">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-orange-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.737-.182a2.5 2.5 0 11-2.476 2.547m5.108-.233l-.648-.648m.648.648l-.648.648" /></svg>
                <div class="flex-1">
                  <h3 class="font-semibold text-navy-900 group-hover:text-orange-700 transition-colors">{link.label}</h3>
                  <p class="mt-1 text-sm text-slate-500">Discuss scope and availability</p>
                </div>
                <svg class="w-4 h-4 text-slate-300 group-hover:text-orange-600 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </div>
            </a>
          ))}
        </div>
      )}
      <div class="text-center mt-8">
        <a href="/services" class="inline-flex items-center gap-2 text-orange-600 font-semibold hover:text-orange-700 transition-colors">
          All services
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900">Find your symptom</h2>
        <p class="mt-3 text-slate-600 max-w-2xl mx-auto">Different hot-water faults need different investigations. Start with what has changed.</p>
      </div>
      {problemsPage && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {problemsPage.links.slice(0, 6).map((link) => (
            <a href={link.path} class="group flex items-center gap-3 bg-paleBlue-50 rounded-xl border border-slate-200 p-4 hover:border-orange-300 hover:shadow-md transition-all">
              <svg class="w-5 h-5 text-orange-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
              <span class="text-sm font-medium text-navy-800 group-hover:text-orange-700 transition-colors flex-1">{link.label}</span>
              <svg class="w-4 h-4 text-slate-300 group-hover:text-orange-600 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section id="areas" class="py-12 sm:py-16 lg:py-20 bg-paleBlue-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900">London coverage</h2>
        <p class="mt-3 text-slate-600 max-w-2xl mx-auto">Priority enquiries include Fulham, Acton and West London. Availability is confirmed for the actual postcode and system.</p>
      </div>
      {areasPage && (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {areasPage.links.map((link) => (
            <a href={link.path} class="group flex items-center gap-2 bg-white rounded-lg border border-slate-200 px-4 py-3 hover:border-orange-300 hover:shadow-md transition-all text-sm">
              <svg class="w-4 h-4 text-orange-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="text-navy-800 group-hover:text-orange-700 transition-colors truncate">{link.label.replace('G3 cylinder and Megaflo enquiries in ', '')}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section id="about" class="py-12 sm:py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <ContentSections sections={page.sections} />
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {brandsPage && (
          <a href="/brands" class="group flex items-center gap-3 bg-paleBlue-50 rounded-xl border border-slate-200 p-5 hover:border-orange-300 hover:shadow-md transition-all">
            <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            <span class="font-medium text-navy-800 group-hover:text-orange-700 transition-colors">Equipment guides</span>
            <svg class="w-4 h-4 text-slate-300 group-hover:text-orange-600 group-hover:translate-x-1 transition-all ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        )}
        {knowledgePage && (
          <a href="/knowledge" class="group flex items-center gap-3 bg-paleBlue-50 rounded-xl border border-slate-200 p-5 hover:border-orange-300 hover:shadow-md transition-all">
            <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            <span class="font-medium text-navy-800 group-hover:text-orange-700 transition-colors">Knowledge base</span>
            <svg class="w-4 h-4 text-slate-300 group-hover:text-orange-600 group-hover:translate-x-1 transition-all ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <FAQBlock faqs={page.faqs} />
    </div>
  </section>

  <section id="contact" class="py-12 sm:py-16 lg:py-20 bg-paleBlue-50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 mb-4">Discuss your cylinder enquiry</h2>
      <p class="text-slate-600 max-w-2xl mx-auto mb-8">Call with your postcode, equipment make and model, and a description of the symptom. The enquiry establishes scope and availability; it is not an automatic booking.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={`tel:${site.phoneE164}`} class="flex items-center justify-center gap-2 bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-3.5 rounded-lg transition-colors text-[16px]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.27 1.02l-2.2 2.2a16 16 0 006.36 6.36l2.2-2.2a1 1 0 011.02-.27l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" /></svg>
          {site.phoneDisplay}
        </a>
        <a href="/contact" class="flex items-center justify-center gap-2 bg-navy-900 hover:bg-navy-800 text-white font-semibold px-6 py-3.5 rounded-lg transition-colors text-[16px]">
          Enquiry form
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
    <SourceNote sourceIds={page.sourceIds} />
  </div>
</div>
