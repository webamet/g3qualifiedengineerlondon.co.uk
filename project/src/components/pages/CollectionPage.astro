---
import PageHero from '../../components/content/PageHero.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';

const { page } = Astro.props;
---
<div>
  <PageHero page={page} />
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={page.breadcrumb} />

    <div class="relative mb-6">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <input
        type="search"
        id="collection-filter"
        placeholder="Filter these guides…"
        class="w-full rounded-lg border border-slate-300 bg-white pl-12 pr-4 py-3 text-[16px] text-navy-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent"
        aria-label="Filter collection"
      />
    </div>

    {page.sections[0] && (
      <p class="text-slate-600 mb-6 text-[16px] leading-relaxed">{page.sections[0].paragraphs[0]}</p>
    )}

    <div id="collection-links" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {page.links.map((link) => (
        <a
          href={link.path}
          data-label={link.label.toLowerCase()}
          data-path={link.path.toLowerCase()}
          class="collection-item group flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-5 py-4 hover:border-orange-300 hover:shadow-md transition-all"
        >
          <span class="text-[15px] font-medium text-navy-800 group-hover:text-orange-700 transition-colors">{link.label}</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-orange-600 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      ))}
    </div>

    <p id="collection-empty" class="text-center text-slate-500 py-8 hidden">No guides match that filter.</p>
  </div>
</div>

<script>
  const filter = document.getElementById('collection-filter');
  const items = document.querySelectorAll('.collection-item');
  const empty = document.getElementById('collection-empty');

  filter?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    let visible = 0;
    items.forEach((item) => {
      const label = item.getAttribute('data-label') || '';
      const path = item.getAttribute('data-path') || '';
      const match = !q || label.includes(q) || path.includes(q);
      (item as HTMLElement).style.display = match ? '' : 'none';
      if (match) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0);
  });
</script>
